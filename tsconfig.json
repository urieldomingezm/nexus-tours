{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "nexus-tours": [
        "./src/index.ts"
      ],
      "nexus-tours/checklist": [
        "./src/checklist.ts"
      ]
    },
    "jsx": "preserve"
  },
  "include": [
    "src"
  ]
}