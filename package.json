{
  "name": "nexus-tours",
  "version": "0.1.0",
  "description": "Product tours that don't break with modals, <dialog>, portals and animated UI. Zero dependencies.",
  "type": "module",
  "main": "./dist/nexus-tours.umd.cjs",
  "module": "./dist/nexus-tours.js",
  "unpkg": "./dist/nexus-tours.all.iife.js",
  "jsdelivr": "./dist/nexus-tours.all.iife.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/nexus-tours.js",
      "require": "./dist/nexus-tours.umd.cjs"
    },
    "./all": {
      "types": "./dist/global.d.ts",
      "import": "./dist/nexus-tours.all.js"
    },
    "./fixtures": {
      "types": "./dist/fixtures.d.ts",
      "import": "./dist/fixtures.js",
      "require": "./dist/fixtures.umd.cjs"
    },
    "./themes": {
      "types": "./dist/themes.d.ts",
      "import": "./dist/themes.js",
      "require": "./dist/themes.umd.cjs"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.js",
      "require": "./dist/vue.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./builder": {
      "types": "./dist/builder.d.ts",
      "import": "./dist/builder.js",
      "require": "./dist/builder.cjs"
    },
    "./supabase": {
      "types": "./dist/supabase.d.ts",
      "import": "./dist/supabase.js",
      "require": "./dist/supabase.cjs"
    },
    "./checklist": {
      "types": "./dist/checklist.d.ts",
      "import": "./dist/checklist.js",
      "require": "./dist/checklist.cjs"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "THIRD_PARTY_NOTICES.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "vite",
    "build": "vite build --mode core && vite build --mode all && vite build --mode fixtures && vite build --mode themes && vite build --mode checklist && vite build --mode supabase && vite build --mode builder && vite build --mode vue && vite build --mode react && tsc -p tsconfig.build.json",
    "build:site": "vite build --mode site",
    "docs:api": "typedoc",
    "build:demo": "vite build --mode demo",
    "dev:site": "vite --mode site-dev site",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --project=chromium",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "size": "node scripts/tamano.mjs",
    "api": "node scripts/api.mjs",
    "api:check": "node scripts/api.mjs --check",
    "prepublishOnly": "npm run build",
    "demo:publicar": "node scripts/publicar-demo.mjs"
  },
  "keywords": [
    "tour",
    "onboarding",
    "product-tour",
    "walkthrough",
    "modal",
    "dialog",
    "accessibility"
  ],
  "license": "MIT",
  "author": {
    "name": "Angel Uriel Domínguez Medina (DevMedina)",
    "url": "https://devmedina.is-a.dev/"
  },
  "homepage": "https://github.com/urieldomingezm/nexus-tours#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/urieldomingezm/nexus-tours.git"
  },
  "bugs": {
    "url": "https://github.com/urieldomingezm/nexus-tours/issues"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.0",
    "@supabase/supabase-js": "^2.119.0",
    "@types/react": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "axios": "^1.21.0",
    "bootstrap-icons": "^1.13.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typedoc": "^0.28.20",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.0.0",
    "vitest": "^5.1.0",
    "vue": "^3.5.45"
  },
  "peerDependencies": {
    "react": ">=18",
    "vue": ">=3.3"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.5"
    }
  }
}
