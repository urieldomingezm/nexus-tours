{
  "name": "nexus-tours",
  "version": "0.1.0",
  "description": "Product tours that don't break with modals, <dialog>, portals and animated UI. Zero dependencies.",
  "type": "module",
  "main": "./dist/nexus-tours.umd.cjs",
  "module": "./dist/nexus-tours.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/nexus-tours.js",
      "require": "./dist/nexus-tours.umd.cjs"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.build.json",
    "test": "node test/tour.test.mjs"
  },
  "keywords": ["tour", "onboarding", "product-tour", "walkthrough", "modal", "dialog", "accessibility"],
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^7.0.0"
  }
}
